SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
# Server-only service_role/secret key. Never copy this into frontend/.env.
SUPABASE_SECRET_KEY=your-service-role-or-secret-key
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=15
USE_MOCK_FALLBACK_IF_KEY_MISSING=true
FRONTEND_URL=http://localhost:5173
